{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchReport",
  "type": "object",
  "required": [
    "subject_name",
    "mode",
    "industry",
    "context_summary",
    "competitor_analysis",
    "market_analysis",
    "gap_analysis",
    "evidence",
    "iterations_run"
  ],
  "properties": {
    "subject_name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["research", "idea_validation"]
    },
    "industry": {
      "type": "string"
    },
    "context_summary": {
      "type": "string"
    },
    "competitor_analysis": {
      "type": "object",
      "required": ["key_competitors", "competitive_positioning", "competitive_risks"],
      "properties": {
        "key_competitors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "competitive_positioning": {
          "type": "string"
        },
        "competitive_risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "market_analysis": {
      "type": "object",
      "required": ["market_size_summary", "growth_trends", "target_audience"],
      "properties": {
        "market_size_summary": {
          "type": "string"
        },
        "growth_trends": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        }
      }
    },
    "gap_analysis": {
      "type": "object",
      "required": ["opportunities", "unmet_needs", "key_risks"],
      "properties": {
        "opportunities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unmet_needs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "category", "source", "confidence"],
        "properties": {
          "claim": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["market", "competitor", "financial", "funding", "risk"]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "iterations_run": {
      "type": "integer",
      "minimum": 1
    }
  }
}